# ──────────────────────────────────────────────────────────────
# NyayaAI Frontend — Environment Configuration Template
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# Base URL of your NyayaAI FastAPI backend.
#
# LOCAL (backend running on your own machine):
VITE_API_BASE_URL=http://127.0.0.1:8000
#
# GOOGLE COLAB (backend running in Colab):
#   Colab runtimes are NOT reachable at localhost from your browser.
#   You must expose the FastAPI server through a tunnel, e.g.:
#     - ngrok:   ngrok http 8000        → use the https://xxxx.ngrok-free.app URL
#     - localtunnel: lt --port 8000     → use the https://xxxx.loca.lt URL
#   Then set:
#   VITE_API_BASE_URL=https://xxxx.ngrok-free.app
#
# DEPLOYED BACKEND:
#   VITE_API_BASE_URL=https://your-deployed-backend.example.com

# Demo Mode — set to "true" to use sample responses without a backend.
# Set to "false" (or remove) to use the real FastAPI backend.
VITE_DEMO_MODE=true
